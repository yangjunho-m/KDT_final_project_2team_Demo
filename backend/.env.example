# 애플리케이션
APP_NAME=defense-surveillance-backend
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL / Docker Compose
DATABASE_URL=postgresql+psycopg://app_user:change_me@postgres:5432/drone_platform
POSTGRES_DB=drone_platform
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_ROOT_USER=change_me
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET_DATASETS=datasets
MINIO_BUCKET_REPORTS=reports
MINIO_BUCKET_ASSETS=assets

# 추론 및 검색
LOCAL_INFERENCE_AGENT_URL=http://localhost:8010
FAISS_INDEX_DIR=storage/faiss
FAISS_DEFAULT_INDEX_NAME=drone-image-geoloc-demo
FAISS_EMBEDDING_MODEL=vit_base_patch16_rope_reg1_gap_256.sbb_in1k
FAISS_EMBEDDING_DIMENSION=768
FAISS_METRIC_TYPE=COSINE
FAISS_SATELLITE_PREFIX=satellite/yeonnam
GAMELOC_SOURCE_DIR=vendor/GTA-UAV/Game4Loc
GAMELOC_CHECKPOINT_PATH=models/gameloc/yeonnam-cross-area.pth
GAMELOC_IMAGE_SIZE=256

# 업로드와 로그
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_EXTENSIONS=.jpg,.jpeg,.png,.webp,.json,.geojson
LOG_LEVEL=INFO

# 인증
SECRET_KEY=replace_with_a_long_random_value
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEMO_ADMIN_USERNAME=demo_admin
DEMO_ADMIN_PASSWORD=replace_with_a_local_only_password
SEED_ADMIN=false
SEED_DEMO_DATA=false
SEED_E2E_FIXTURE=false

# 시나리오와 드론 재생
SCENARIO_TICK_SCHEDULER_ENABLED=true
SCENARIO_TICK_INTERVAL_SECONDS=1.0
DRONE_VIEW_PLAYBACK_ENABLED=true
DRONE_VIEW_DATASET_PREFIX=drone-route
DRONE_VIEW_JAMMING_DATASET_PREFIX=jamming-route
DRONE_VIEW_SPOOFING_DATASET_PREFIX=spoofing-route
DRONE_VIEW_DRONE_C_DATASET_PREFIX=songdo-route
DRONE_VIEW_DRONE_C_METADATA_FILE=metadata_songdo.csv
DRONE_VIEW_DRONE_C_IMAGE_DATASET_PREFIX=drone-route
DRONE_VIEW_DRONE_C_IMAGE_ROUTE_ID=ROUTE_B
DRONE_VIEW_DRONE_C_IMAGE_SCENARIO_NAME=NORMAL
DRONE_VIEW_METADATA_FILE=metadata.csv
DRONE_VIEW_SIMULATION_FILE=drone_surveillance_simulation.csv
DRONE_VIEW_PLAYBACK_SPEED=1.0
AUTO_CREATE_DEMO_DRONES=true
SEED_DRONE_VIEW_DATASET=false
DRONE_VIEW_OPERATION_AREA_ID=AREA-DATASET-001
DRONE_VIEW_OPERATION_AREA_NAME=CSV 기반 시연 작전지역
DRONE_VIEW_OPERATION_CENTER_LATITUDE=37.4938882
DRONE_VIEW_OPERATION_CENTER_LONGITUDE=126.7333912
