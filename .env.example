# 루트에서 공통으로 참고하는 로컬 개발용 예시입니다.
# 실제 값은 각 서비스의 .env.example을 복사한 .env에 작성하세요.

# Backend API
APP_NAME=defense-surveillance-backend
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql+psycopg://app_user:change_me@localhost:5432/drone_platform
POSTGRES_DB=drone_platform
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_ROOT_USER=change_me
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET_DATASETS=datasets
MINIO_BUCKET_REPORTS=reports
MINIO_BUCKET_ASSETS=assets
LOCAL_INFERENCE_AGENT_URL=http://localhost:8010
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_EXTENSIONS=.jpg,.jpeg,.png,.webp,.json,.geojson
LOG_LEVEL=INFO
SECRET_KEY=replace_with_a_long_random_value
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEMO_ADMIN_USERNAME=demo_admin
DEMO_ADMIN_PASSWORD=replace_with_a_local_only_password
SEED_ADMIN=false
SEED_DEMO_DATA=false
SEED_E2E_FIXTURE=false
SCENARIO_TICK_SCHEDULER_ENABLED=true
SCENARIO_TICK_INTERVAL_SECONDS=1.0

# AI server
AI_SERVER_HOST=0.0.0.0
AI_SERVER_PORT=8010
AI_PROVIDER_MODE=dummy
EMBEDDING_PROVIDER=dummy
DETECTOR_PROVIDER=dummy
LLM_PROVIDER=dummy
VECTOR_STORE_PATH=data/processed/vector_store.json
VIDEO_UPLOAD_DIR=uploads/videos
FRAME_SAMPLE_SECONDS=1.0
MAX_FRAMES=120
EMBEDDING_DIM=384
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_CLIP_MODEL=ViT-B-32
LOCAL_CLIP_PRETRAINED=openai
LOCAL_DETECTOR_MODEL=yolov8n.pt
LOCAL_LLM_MODEL_PATH=ai-server/models/llm.gguf
EXTERNAL_EMBEDDING_URL=
EXTERNAL_DETECTOR_URL=
EXTERNAL_LLM_URL=
EXTERNAL_API_KEY=

# Frontend
# VITE_ 값은 브라우저에 공개되므로 비밀키를 넣지 마세요.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
VITE_NAVER_MAP_CLIENT_ID=replace_with_naver_map_client_id
